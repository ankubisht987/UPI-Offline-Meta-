SPRING_APPLICATION_NAME=upi-offline-Bridge
SERVER_PORT=1000

# Supabase PostgreSQL
DB_URL=jdbc:postgresql://YOUR_SUPABASE_POOLER_HOST:5432/postgres
DB_USERNAME=YOUR_SUPABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# Logging
LOGGING_LEVEL_COM_ANKUSH=INFO
LOGGING_LEVEL_COM_ANKUSH_UPI_OFFLINE_META=INFO

# Custom properties
UPI_MESH_PACKET_MAX_AGE_SECONDS=86400
